        "options": {}
      },
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "id": "config"
    },
    {
      "parameters": {
        "command": "=set -o pipefail; mkdir -p \"{{ $('Config').first().json.outDir }}\" && cd \"{{ $('Config').first().json.binDir }}\" && ./matrix -name \"{{ $('Config').first().json.nameCol }}\" -step \"{{ $('Config').first().json.stepCol }}\" -expected \"{{ $('Config').first().json.expectedCol }}\" -num \"{{ $('Config').first().json.numCol }}\" \"{{ $('Config').first().json.matrixCsv }}\" > \"{{ $('Config').first().json.outDir }}/matrix.json\" && ./suite -key \"{{ $('Config').first().json.keyCol }}\" \"{{ $('Config').first().json.suiteCsv }}\" > \"{{ $('Config').first().json.outDir }}/suite.json\" && ./join -blocked \"{{ $('Config').first().json.blockedRegex }}\" \"{{ $('Config').first().json.outDir }}/matrix.json\" \"{{ $('Config').first().json.outDir }}/suite.json\" | ./casecheck"
      },
      "name": "Prepare",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        440,
        0
      ],
      "id": "prepare"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst out = JSON.parse($input.first().json.stdout);\nconst cfg = $('Config').first().json;\nconst only = cfg.onlyIds ? cfg.onlyIds.split(',').map(s => s.trim()) : null;\nconst b64 = s => Buffer.from(s).toString('base64');\nconst skipped = {};\nfor (const c of out.cases) if (c.status !== 'ready') skipped[c.status] = (skipped[c.status] || 0) + 1;\nreturn out.cases\n  .filter(c => c.status === 'ready' && (!only || only.includes(String(c.id))))\n  .map(c => ({ json: { id: c.id, name: c.name, caseB64: b64(JSON.stringify(c)),\n    minThen: c.steps.filter(s => s.expected).length,   // lint: one Entonces per expected result\n    mapB64: b64('{}'), lmTried: false, skipped } }));\n"
      },
      "name": "Pick Ready Cases",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "id": "pick-ready-cases"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return { json: $json };"
      },
      "name": "Skeleton Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "id": "skeleton-input"
    },
    {
      "parameters": {
        "command": "={{ \"echo \" + $json.caseB64 + \" | base64 -d | \\\"\" + $('Config').first().json.binDir + \"/skeleton\\\" -tags \\\"\" + $('Config').first().json.tagCols + \"\\\" -map-b64 \\\"\" + $json.mapB64 + \"\\\"\" }}",
        "executeOnce": false
      },
      "name": "Skeleton",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1100,
        0
      ],
      "id": "skeleton"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst st = $('Skeleton Input').item.json;\nlet r;\ntry { r = JSON.parse($json.stdout); } catch (e) { r = { feature: '', warnings: ['skeleton failed: ' + $json.stderr] }; }\nconst dropped = [...r.warnings.join('\\n').matchAll(/data column \"([^\"]+)\" is not used/g)].map(m => m[1]);\nreturn { json: { ...st, feature: r.feature, warnings: r.warnings, dropped,\n  b64: Buffer.from(r.feature).toString('base64') } };\n"
      },
      "name": "Parse Skeleton",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "id": "parse-skeleton"
    },
    {
      "parameters": {
        "command": "={{ \"echo \" + $json.b64 + \" | base64 -d | \\\"\" + $('Config').first().json.binDir + \"/lint\\\" -min-then \" + $json.minThen + \" -max-scenarios 1\" }}",
        "executeOnce": false
      },
      "name": "Lint",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1540,
        0
      ],
      "id": "lint"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst st = $('Parse Skeleton').item.json, cfg = $('Config').first().json;\nlet r;\ntry { r = JSON.parse($json.stdout); } catch (e) { r = { ok: false, errors: ['lint output was not JSON: ' + $json.stderr], needs_input: [] }; }\n// the model is only worth calling when data would otherwise be dropped (or when forced)\nconst ask = !st.lmTried && (cfg.useLm === 'always' || (cfg.useLm === 'auto' && st.dropped.length > 0));\nconst notes = [...r.errors.map(e => 'LINT: ' + e), ...st.warnings, ...r.needs_input].join('\\n');\n// clean = lint passes AND no data column was dropped; anything else goes to features/review/\nreturn { json: { ...st, ok: r.ok, clean: r.ok && st.dropped.length === 0, errors: r.errors, ask,\n  file: st.name.normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').replace(/[^\\w.-]+/g, '_') + '.feature',\n  notesB64: notes ? Buffer.from(notes + '\\n').toString('base64') : '' } };\n"
      },
      "name": "Parse Lint",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        0
      ],
      "id": "parse-lint"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "ask",
              "leftValue": "={{ $json.ask }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "Ask LM?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1980,
        0
      ],
      "id": "ask-lm"
    },
    {
      "parameters": {
        "command": "={{ \"echo \" + $json.caseB64 + \" | base64 -d | \\\"\" + $('Config').first().json.binDir + \"/skeleton\\\" -plan -tags \\\"\" + $('Config').first().json.tagCols + \"\\\" -map-b64 \\\"\" + $json.mapB64 + \"\\\"\" }}",
        "executeOnce": false
      },
      "name": "Plan",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        2200,
        120
      ],
      "id": "plan"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst st = $('Parse Lint').item.json, cfg = $('Config').first().json;\nconst body = { model: cfg.lmModel || undefined, reasoning_effort: cfg.reasoningEffort || undefined, temperature: 0.1,\n  messages: [{ role: 'system', content: cfg.mapPrompt }, { role: 'user', content: $json.stdout }],\n  response_format: { type: 'json_schema', json_schema: { name: 'map', schema: {\"type\": \"object\", \"additionalProperties\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"field\": {\"type\": \"string\"}, \"literal\": {\"type\": \"string\"}}, \"required\": [\"field\", \"literal\"]}}} } } };\nreturn { json: { ...st, body: JSON.stringify(body) } };\n"
      },
      "name": "Build LM Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        120
      ],
      "id": "build-lm-prompt"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.lmUrl }}/chat/completions",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.body }}",
        "options": {
          "timeout": 300000
        }
      },
      "name": "LM Studio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2640,
        120
      ],
      "id": "lm-studio"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst st = $('Build LM Prompt').item.json;\nlet t = $json.choices[0].message.content.replace(/<think>[\\s\\S]*?<\\/think>/g, '').trim();\nt = t.replace(/^```[a-z]*\\n?/i, '').replace(/\\n?```$/, '');\nlet m = {};\ntry { const p = JSON.parse(t); if (p && typeof p === 'object' && !Array.isArray(p)) m = p; } catch (e) {}  // bad JSON = no extra mapping\nreturn { json: { ...st, mapB64: Buffer.from(JSON.stringify(m)).toString('base64'), lmTried: true } };\n"
      },
      "name": "Extract Map",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        120
      ],
      "id": "extract-map"
    },
    {
      "parameters": {
        "command": "={{ \"d=\\\"\" + $('Config').first().json.outDir + \"/features\" + ($json.clean ? \"\" : \"/review\") + \"\\\"; mkdir -p \\\"$d\\\" && echo \" + $json.b64 + \" | base64 -d > \\\"$d/\" + $json.file + \"\\\"\" + ($json.notesB64 ? \" && echo \" + $json.notesB64 + \" | base64 -d > \\\"$d/\" + $json.file + \".notes.txt\\\"\" : \"\") + \" && echo \\\"$d/\" + $json.file + \"\\\"\" }}",
        "executeOnce": false
      },
      "name": "Save",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        2200,
        -120
      ],
      "id": "save"
    }
  ],
