    {
      "parameters": {
        "executeOnce": true,
        "command": "=cd \"{{ $('Config Crawl').first().json.cwd }}\" && \"{{ $('Config Crawl').first().json.hydra }}\" crawl --project \"{{ $('Config Crawl').first().json.project }}\" 2>&1"
      },
      "name": "hydra crawl",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        480,
        500
      ],
      "id": "hydra-crawl"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\n// One row per run. Lines that are not JSON (errors, crawl progress) are kept as a 'log' row so nothing is hidden.\nconst out = [], text = ($input.first().json.stdout || '') + ($input.first().json.stderr || '');\nfor (const line of text.split('\\n').filter(Boolean)) {\n  try { const r = JSON.parse(line); out.push({ json: { key: r.key, intent: r.intent, tier: r.tier, status: r.status,\n    tokens: r.tokens, ms: r.ms, detail: (r.detail || []).join(' | ') } }); }\n  catch (e) { out.push({ json: { log: line } }); }\n}\nreturn out.length ? out : [{ json: { log: 'No runs: nothing new, or no issue carries the automate/execute label (poll), or the command printed nothing.' } }];\n"
      },
      "name": "Runs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        240
      ],
      "id": "runs"
    }
