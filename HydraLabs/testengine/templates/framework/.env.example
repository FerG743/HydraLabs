# Copia este archivo como .env y completa. NUNCA subas el .env real (ya está en .gitignore).

# ── Configuración de ejecución ──
BROWSER=chrome
BASE_URL=http://localhost:3000
HEADLESS=false
EXPLICIT_WAIT=20

# ── Aplicativo ──
# Modo MAC = todo local. Requiere VPN encendida para que los backends no fallen.
PORTAL_API_ENV=MAC
